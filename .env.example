# .env로 복사해서 실제 값을 채운다. .env는 git에 커밋하지 않는다.
DB_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# POST /rag/embed(법령 등록) 호출 시 X-Admin-Key 헤더로 전달한다.
ADMIN_API_KEY=
# 국가법령정보 공동활용 API 인증키(OC). 신청 시 직접 지정한 값.
LAW_OC=
DEDUCTION_ANALYZER=
NTS_BUSINESS_API_KEY=
NTS_BUSINESS_API_URL=https://api.odcloud.kr/api/nts-businessman/v1/status
NTS_BUSINESS_TIMEOUT_SECONDS=10
# 현재 파서 계약: Naver CLOVA Template OCR V2의 /infer 응답(fields[].name).
# 실제 계정에 배포된 상품/템플릿 설정은 별도 확인이 필요하다.
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=
OCR_PIPELINE=
# 기존 스켈레톤 호환용 별칭. CLOVA_OCR_SECRET_KEY가 비어 있을 때만 사용한다.
CLOVA_API_KEY=
STORAGE_DIR=storage
S3_BUCKET=
AWS_REGION=ap-northeast-2
PDFKIT_WKHTMLTOPDF_PATH=
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
CLOVA_TIMEOUT_SECONDS=10

# Password reset email: 587 uses STARTTLS; 465 requires SMTP_USE_SSL=true.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Luna low 문서 인식: 두 값을 설정해야 동기/워커 경로가 함께 적용됩니다.
# RECEIPT_RECOGNITION_BACKEND=luna_low
# OCR_PIPELINE=app.ocr_pipeline.luna:create_pipeline
LUNA_TIMEOUT_SECONDS=180
LUNA_BUDGET_KRW=2000
LUNA_BUDGET_LEDGER_FILE=storage/luna_budget.json
LOCAL_FRONTEND_ORIGIN=
