# .env로 복사해서 실제 값을 채운다. .env는 git에 커밋하지 않는다.
DB_URL=postgresql://taxai_user:changeme@localhost:5432/taxai
JWT_SECRET=changeme
OPENAI_API_KEY=
# 현재 파서 계약: Naver CLOVA Template OCR V2의 /infer 응답(fields[].name).
# 실제 계정에 배포된 상품/템플릿 설정은 별도 확인이 필요하다.
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=
# 기존 스켈레톤 호환용 별칭. CLOVA_OCR_SECRET_KEY가 비어 있을 때만 사용한다.
CLOVA_API_KEY=
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
CLOVA_TIMEOUT_SECONDS=10
